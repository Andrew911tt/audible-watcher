# systemd unit for Audible Watcher (Linux).
# 1. Edit User= and the two paths below to match your install.
# 2. sudo cp audible-watcher.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now audible-watcher
[Unit]
Description=Audible Watcher - new release monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/audible-watcher
ExecStart=/usr/bin/python3 /home/YOUR_USERNAME/audible-watcher/app.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
